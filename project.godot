; Engine configuration file.
config_version=5

[application]

config/name="Drone Yard VR"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.png"

[autoload]

GameData="*res://scripts/game_data.gd"
Sfx="*res://scripts/sfx.gd"
FX="*res://scripts/fx.gd"

[editor_plugins]

enabled=PackedStringArray()

[physics]

common/max_physics_steps_per_frame=4

common/physics_ticks_per_second=90

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1

[xr]

openxr/enabled=true
openxr/foveation_level=3
openxr/foveation_dynamic=true
shaders/enabled=true
